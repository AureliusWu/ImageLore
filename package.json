{
  "name": "imagelore",
  "private": true,
  "version": "0.25.1",
  "type": "module",
  "scripts": {
    "version:sync": "node scripts/sync_version.mjs",
    "version:check": "node scripts/check_version.mjs",
    "version:patch": "node scripts/bump_version.mjs patch",
    "version:minor": "node scripts/bump_version.mjs minor",
    "version:major": "node scripts/bump_version.mjs major",
    "dev": "node scripts/sync_version.mjs && vite",
    "build": "node scripts/sync_version.mjs && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node scripts/sync_version.mjs && tauri dev",
    "tauri:build": "node scripts/sync_version.mjs && tauri build --bundles nsis -- --locked",
    "check": "node scripts/check_version.mjs && python scripts/check_project.py && python scripts/test_schema.py && python scripts/test_scale.py && python scripts/test_contract.py && npm run test:preview && npm run test:remix && npm run test:browser && npm run format:check && npm run lint",
    "test:preview": "node --experimental-strip-types --test scripts/test_preview_workflow.mjs",
    "test:remix": "node --experimental-strip-types --test scripts/test_remix_workflow.mjs",
    "test:browser": "node --test scripts/test_browser_extension.mjs",
    "format": "npx --yes @biomejs/biome@2.5.14 format --write src browser-extension scripts vite.config.ts --files-ignore-unknown=true",
    "format:check": "npx --yes @biomejs/biome@2.5.14 ci src browser-extension scripts vite.config.ts --files-ignore-unknown=true",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
