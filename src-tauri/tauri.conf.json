{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ImageLore",
  "version": "0.23.0",
  "identifier": "app.imagelore.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ImageLore",
        "width": 1520,
        "height": 940,
        "minWidth": 1160,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/app.imagelore.desktop/cache/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "ImageLore Project",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "ImageLore"
      },
      "allowDowngrades": false
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
